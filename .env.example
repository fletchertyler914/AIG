# ── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres connection string. Locally, use `vercel env pull` or copy
# the value from the Vercel dashboard.
DATABASE_URL="postgresql://user:password@localhost:5432/aig?sslmode=disable"

# ── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Arcade ───────────────────────────────────────────────────────────────────
# Get one at https://app.arcade.dev/register
ARCADE_API_KEY="arc_..."
# Optional override for the Arcade engine URL (cloud default if unset).
# ARCADE_BASE_URL=
# Verifier mode. See ADR-0010. The Arcade Dashboard "custom verifier" setting is
# project-global, so a single Arcade project can only be in one mode at a time.
# Recommended for single-project setups (MVP): set `arcade` in both dev and
# prod. Personal OAuth uses operator email as Arcade user_id; Arcade default
# OAuth apps just work. Switch to `custom` only when you maintain separate
# Arcade projects per environment (dev vs prod) so each can have its own
# verifier URL. Custom mode requires BYO OAuth credentials in the Dashboard.
ARCADE_VERIFIER_MODE=arcade
# Optional Arcade MCP gateway URL for opt-in live integration tests.
# This is the MCP client endpoint, not the arcadejs engine base URL.
ARCADE_MCP_GATEWAY_URL="https://api.arcade.dev/mcp/your-gateway"
# Optional OAuth bearer token for direct MCP initialize/tools calls.
# If unset, tests only assert the gateway is reachable and auth-enforced.
# ARCADE_MCP_AUTH_TOKEN=

# ── Auth (Better Auth + Resend magic links) ──────────────────────────────────
# 32+ byte random string. Generate with `openssl rand -hex 32`.
BETTER_AUTH_SECRET="change-me-please-generate-with-openssl-rand-hex-32"
# Public origin of the running app. Used for magic-link callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
# Vercel sets these automatically. Preview deployments use VERCEL_URL as the
# public origin so auth cookies and OAuth callbacks match the preview hostname.
# VERCEL_ENV=preview
# VERCEL_URL=your-preview-deployment.vercel.app
# Resend API key. Optional in dev — if unset, magic links are logged to console.
# RESEND_API_KEY="re_..."
# From address for transactional email (must be a verified Resend domain in prod).
EMAIL_FROM="AIG <noreply@aig.local>"

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Demo (used by scripts/demo-seed.ts) ──────────────────────────────────────
DEMO_USER_ID="demo@arcadeintent.graph"
# Keep false unless you have a dedicated test Slack workspace + channel.
DEMO_USE_SLACK=false
