{
  "name": "aig",
  "version": "0.1.0",
  "private": true,
  "description": "Arcade Intent Graph — pre-execution governance runtime for Arcade-powered AI agents.",
  "license": "MIT",
  "author": "Tyler Fletcher <fletchertyler914@users.noreply.github.com>",
  "homepage": "https://github.com/fletchertyler914/aig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fletchertyler914/aig.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:arcade:live": "RUN_ARCADE_INTEGRATION=1 vitest run tests/integration/arcade-live.test.ts",
    "test:eval": "EVAL_MODE=${EVAL_MODE:-mock} vitest run eval",
    "test:eval:live": "EVAL_MODE=live vitest run eval",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_USE_PROD_BUILD=1 playwright test tests/e2e/api-prod.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "probe:arcade": "tsx scripts/probe-arcade.ts",
    "live:plan": "tsx scripts/live-plan.ts",
    "live:loop": "tsx scripts/live-loop.ts",
    "live:prompt-loop": "tsx scripts/live-prompt-loop.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@arcadeai/arcadejs": "^2.4.1",
    "@next/env": "16.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/otel": "^2.1.2",
    "ai": "^6.0.190",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.8",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
